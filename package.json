{
  "name": "@intech-software/chronera",
  "version": "0.2.9",
  "description": "A universal, type-safe date, time, calendar, era, locale, and timezone toolkit for JavaScript and TypeScript.",
  "keywords": [
    "date",
    "time",
    "calendar",
    "timezone",
    "internationalization",
    "i18n",
    "buddhist-calendar",
    "hijri",
    "iso8601",
    "rfc2822",
    "julian-day",
    "cldr",
    "clean-architecture",
    "zero-dependencies",
    "typescript",
    "drizzle",
    "drizzle-orm",
    "arktype",
    "zod",
    "valibot",
    "react",
    "react-hooks",
    "thai",
    "thai-calendar",
    "tax",
    "fiscal-year",
    "overtime",
    "superjson",
    "standard-schema",
    "dayjs-compat"
  ],
  "author": "Pawapon Thammalangka <108130529+ParkPawapon@users.noreply.github.com> (https://github.com/ParkPawapon)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTECH-Software-House/chronera-js.git"
  },
  "homepage": "https://github.com/INTECH-Software-House/chronera-js#readme",
  "bugs": {
    "url": "https://github.com/INTECH-Software-House/chronera-js/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ParkPawapon"
    }
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./parse": {
      "types": "./dist/parse/index.d.ts",
      "import": "./dist/parse/index.js"
    },
    "./holidays": {
      "types": "./dist/holidays/index.d.ts",
      "import": "./dist/holidays/index.js"
    },
    "./scheduling": {
      "types": "./dist/scheduling/index.d.ts",
      "import": "./dist/scheduling/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.js"
    },
    "./valibot": {
      "types": "./dist/valibot/index.d.ts",
      "import": "./dist/valibot/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./standard": {
      "types": "./dist/standard/index.d.ts",
      "import": "./dist/standard/index.js"
    },
    "./superjson": {
      "types": "./dist/superjson/index.d.ts",
      "import": "./dist/superjson/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    },
    "./arktype": {
      "types": "./dist/arktype/index.d.ts",
      "import": "./dist/arktype/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "arktype": "^2.0.0",
    "drizzle-orm": ">=0.30.0",
    "react": "^18.0.0 || ^19.0.0",
    "superjson": "^1.12.0 || ^2.0.0",
    "valibot": "^1.0.0",
    "zod": "^3.22.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "superjson": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {},
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm check:architecture && pnpm typecheck && pnpm test && pnpm size-limit && pnpm pack:check",
    "check:architecture": "node --import tsx scripts/check-architecture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tstyche",
    "test:browser": "playwright test",
    "test:property": "vitest run tests/property",
    "test:fuzz": "vitest run tests/fuzz",
    "benchmark": "vitest bench",
    "size-limit": "size-limit",
    "prepare": "simple-git-hooks",
    "data:build": "node --import tsx scripts/build-calendar-data.ts",
    "data:check": "node --import tsx scripts/validate-fixtures.ts",
    "pack:artifact": "pnpm build && pnpm pack --pack-destination artifacts",
    "pack:check": "node scripts/check-package.mjs && node scripts/verify-consumers.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "prepack": "pnpm build",
    "release:check": "pnpm check && pnpm test:types && pnpm data:check",
    "release:automated": "node --import tsx scripts/automate-release.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "name": "Root (@intech-software/chronera)",
      "path": "dist/index.js",
      "limit": "48 KB"
    },
    {
      "name": "Calendar (@intech-software/chronera/calendar)",
      "path": "dist/calendar/index.js",
      "limit": "15 KB"
    },
    {
      "name": "Format (@intech-software/chronera/format)",
      "path": "dist/format/index.js",
      "limit": "15 KB"
    },
    {
      "name": "Parse (@intech-software/chronera/parse)",
      "path": "dist/parse/index.js",
      "limit": "10 KB"
    },
    {
      "name": "Holidays (@intech-software/chronera/holidays)",
      "path": "dist/holidays/index.js",
      "limit": "15 KB"
    },
    {
      "name": "Scheduling (@intech-software/chronera/scheduling)",
      "path": "dist/scheduling/index.js",
      "limit": "30 KB"
    },
    {
      "name": "Zod (@intech-software/chronera/zod)",
      "path": "dist/zod/index.js",
      "limit": "28 KB"
    },
    {
      "name": "Valibot (@intech-software/chronera/valibot)",
      "path": "dist/valibot/index.js",
      "limit": "28 KB"
    },
    {
      "name": "Compat (@intech-software/chronera/compat)",
      "path": "dist/compat/index.js",
      "limit": "28 KB"
    },
    {
      "name": "Testing (@intech-software/chronera/testing)",
      "path": "dist/testing/index.js",
      "limit": "28 KB"
    },
    {
      "name": "Standard (@intech-software/chronera/standard)",
      "path": "dist/standard/index.js",
      "limit": "28 KB"
    },
    {
      "name": "SuperJSON (@intech-software/chronera/superjson)",
      "path": "dist/superjson/index.js",
      "limit": "28 KB"
    },
    {
      "name": "Drizzle (@intech-software/chronera/drizzle)",
      "path": "dist/drizzle/index.js",
      "limit": "28 KB"
    },
    {
      "name": "ArkType (@intech-software/chronera/arktype)",
      "path": "dist/arktype/index.js",
      "limit": "28 KB"
    },
    {
      "name": "React (@intech-software/chronera/react)",
      "path": "dist/react/index.js",
      "limit": "30 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "4.1.11",
    "arktype": "^2.2.8",
    "drizzle-orm": "^0.45.4",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "13.0.3",
    "superjson": "^2.2.6",
    "tstyche": "7.2.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "valibot": "^1.5.0",
    "vitest": "4.1.11",
    "zod": "^3.25.76"
  },
  "overrides": {
    "source-map-js": ">=1.2.2",
    "fast-uri": ">=3.1.8",
    "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12"
  }
}
